# Copy this file to .env and fill in your own values. .env is git-ignored.

# P3 agent - DeepSeek backend (OpenAI-compatible API, used through the openai SDK)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# P2 - Hugging Face token (needed for gated models such as Meta Prompt Guard 2)
HF_TOKEN=

# P3 agent - local Ollama backend (Iteration 3)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Optional - OpenAI backend, not used by default
OPENAI_API_KEY=
OPENAI_MODEL=
GUARD_JUDGE_SALT=change-me  # secret for the judge's text markers (guardrail/judge.py)
